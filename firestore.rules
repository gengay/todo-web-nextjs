rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsTask(data) {
      return request.auth != null && data.userId == request.auth.uid;
    }

    function validTask(data) {
      return data.keys().hasAll([
          'userId',
          'title',
          'description',
          'priority',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'uid',
          'title',
          'description',
          'priority',
          'completed',
          'done',
          'status',
          'createdAt',
          'updatedAt',
          'completedAt',
          'dueDate'
        ])
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.description is string
        && data.description.size() <= 2000
        && data.priority in ['low', 'medium', 'high']
        && data.keys().hasAny(['completed', 'done', 'status'])
        && (!data.keys().hasAny(['completed']) || data.completed is bool)
        && (!data.keys().hasAny(['done']) || data.done is bool)
        && (!data.keys().hasAny(['status']) || data.status is string)
        && (data.createdAt is timestamp || data.createdAt is string)
        && (data.updatedAt is timestamp || data.updatedAt is string)
        && (!data.keys().hasAny(['dueDate'])
          || data.dueDate == null
          || data.dueDate is timestamp
          || data.dueDate is string);
    }

    match /tasks/{taskId} {
      allow read: if ownsTask(resource.data);
      allow create: if request.auth != null && validTask(request.resource.data);
      allow update: if ownsTask(resource.data)
        && validTask(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if ownsTask(resource.data);
    }

    match /users/{userId}/todos/{todoId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validTodo(data) {
        return data.keys().hasAll([
            'uid',
            'title',
            'description',
            'priority',
            'completed',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasOnly([
            'uid',
            'title',
            'description',
            'priority',
            'completed',
            'createdAt',
            'updatedAt'
          ])
          && data.uid == userId
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 160
          && data.description is string
          && data.description.size() <= 2000
          && data.priority in ['low', 'medium', 'high']
          && data.completed is bool
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      allow read: if isOwner();
      allow create: if isOwner() && validTodo(request.resource.data);
      allow update: if isOwner()
        && validTodo(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
